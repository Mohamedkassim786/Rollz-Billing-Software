{
  "name": "rollz-pos-server",
  "version": "0.1.0",
  "private": true,
  "description": "ROLLZ POS Backend Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/preload.ts --test --test-concurrency=1 tests/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "backup": "tsx src/scripts/backupDatabase.ts",
    "restore": "tsx src/scripts/restoreDatabase.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.4.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
